{
  "name": "picktrip-hotel-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n web,mastra -c blue,magenta \"npm:dev:web\" \"npm:dev:mastra\"",
    "dev:web": "next dev",
    "dev:mastra": "node --env-file-if-exists=.env.local ./node_modules/mastra/dist/index.js dev",
    "build": "npm run build:web",
    "build:web": "next build",
    "build:mastra": "node --env-file-if-exists=.env.local ./node_modules/mastra/dist/index.js build",
    "smoke:mastra": "node --env-file-if-exists=.env.local --import tsx src/scripts/smoke-mastra.ts",
    "start": "next start",
    "start:mastra": "node --env-file-if-exists=.env.local ./node_modules/mastra/dist/index.js start",
    "setup:indices": "tsx src/scripts/setup-indices.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/provider": "2.0.3",
    "@elastic/elasticsearch": "9.5.0",
    "@mastra/core": "1.60.0",
    "@mastra/elasticsearch": "1.3.1",
    "@mastra/libsql": "1.21.0",
    "@mastra/memory": "1.27.0",
    "@mastra/observability": "1.17.1",
    "dotenv": "17.4.2",
    "firebase": "12.13.0",
    "firebase-admin": "13.5.0",
    "lucide-react": "0.577.0",
    "mapbox-gl": "3.25.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "mastra": "1.25.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
