# Runtime: Node 22.22.1 or newer. Never commit real values.
PICKTRIP_API_URL=https://beta-api.picktrip.app
MASTRA_BASE_URL=http://localhost:4111

# Public browser configuration
# Local dev automatically reads the public Mapbox token from
# ../Picktrip_web_app/.env.local. Override that path when the repos are elsewhere.
PICKTRIP_PUBLIC_ENV_PATH=
NEXT_PUBLIC_MAPBOX_TOKEN=
# Firebase resolves env first, then ../App-iOS/PickTrip/GoogleService-Info.plist,
# then Picktrip's public project config. Set this only for a different iOS checkout.
PICKTRIP_IOS_GOOGLE_PLIST_PATH=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mastra model
OPENROUTER_API_KEY=

# Elasticsearch Cloud or local Docker. These stay server-only.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
PREFERENCE_INDEX_ALIAS=picktrip-memory-preferences
CONVERSATION_INDEX_ALIAS=picktrip-memory-turns
ELASTIC_INDEX_VERSION=v1
PREFERENCE_INFERENCE_ID=.jina-embeddings-v5-text-small
MEMORY_INFERENCE_ID=.jina-embeddings-v5-text-small
